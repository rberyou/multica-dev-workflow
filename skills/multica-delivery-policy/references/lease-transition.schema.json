{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rberyou/multica-dev-workflow/main/skills/multica-delivery-policy/references/lease-transition.schema.json",
  "title": "Multica Workspace Lease Transition Batch Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_read_id",
    "inventory_selection_rule",
    "inventory_complete",
    "requirement_root_ids",
    "discovered_requirement_root_ids",
    "migration_groups",
    "endpoint_inventory",
    "discovered_issue_inventory",
    "current_claims"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "snapshot_read_id": {"$ref": "#/$defs/identifier"},
    "inventory_selection_rule": {"const": "protocol-v4-terminal-authority-mirror-v1"},
    "inventory_complete": {"const": true},
    "requirement_root_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "discovered_requirement_root_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "migration_groups": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/group"}
    },
    "endpoint_inventory": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/endpoint"}
    },
    "discovered_issue_inventory": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "object"}
    },
    "current_claims": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^(v3\\.sha256:)?[0-9a-f]{64}$"},
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "git", "historical_holder", "authority", "mirror"],
      "properties": {
        "root": {"$ref": "#/$defs/root"},
        "git": {"$ref": "#/$defs/git"},
        "historical_holder": {"$ref": "#/$defs/holder"},
        "authority": {"$ref": "#/$defs/authority"},
        "mirror": {"$ref": "#/$defs/mirror"}
      }
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id", "status", "workflow_instance_id", "workspace_mode",
        "plan_schema_version", "plan_revision", "current_plan_revision",
        "approved_policy_digest", "current_policy_digest", "target_branch",
        "current_target_branch", "active_child_issue_ids",
        "pending_review_issue_ids", "open_approval_gates",
        "review_evidence_current", "approval_evidence_current",
        "merge_evidence_current", "delivery_evidence_current", "delivery_complete"
      ],
      "properties": {
        "issue_id": {"$ref": "#/$defs/identifier"},
        "status": {"type": "string"},
        "workflow_instance_id": {"$ref": "#/$defs/identifier"},
        "workspace_mode": {"enum": ["branch_only", "lightweight", "isolated"]},
        "plan_schema_version": {"enum": [1, 2, 3]},
        "plan_revision": {"type": "integer", "minimum": 1},
        "current_plan_revision": {"type": "integer", "minimum": 1},
        "approved_policy_digest": {"$ref": "#/$defs/digest"},
        "current_policy_digest": {"$ref": "#/$defs/digest"},
        "target_branch": {"$ref": "#/$defs/identifier"},
        "current_target_branch": {"$ref": "#/$defs/identifier"},
        "plan_frozen_fields": {
          "type": "array",
          "prefixItems": [{"const": "plan_revision"}, {"const": "policy_digest"}, {"const": "target_branch"}],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "active_child_issue_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "pending_review_issue_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "open_approval_gates": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "review_evidence_current": {"type": "boolean"},
        "approval_evidence_current": {"type": "boolean"},
        "merge_evidence_current": {"type": "boolean"},
        "delivery_evidence_current": {"type": "boolean"},
        "delivery_complete": {"type": "boolean"}
      },
      "allOf": [{"if": {"properties": {"plan_schema_version": {"const": 3}}}, "then": {"required": ["plan_frozen_fields"]}}]
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "unfinished_operations", "branch", "expected_branch", "head_sha", "expected_head_sha", "worktree_id", "expected_worktree_id"],
      "properties": {
        "clean": {"type": "boolean"},
        "unfinished_operations": {"type": "array", "items": {"type": "string"}},
        "branch": {"$ref": "#/$defs/identifier"},
        "expected_branch": {"$ref": "#/$defs/identifier"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
        "expected_head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
        "worktree_id": {"$ref": "#/$defs/identifier"},
        "expected_worktree_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "holder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "agent_id", "agent_role", "status", "active", "root_requirement_id", "workflow_instance_id"],
      "properties": {
        "issue_id": {"$ref": "#/$defs/identifier"},
        "agent_id": {"$ref": "#/$defs/identifier"},
        "agent_role": {"enum": ["developer", "reviewer", "integrator"]},
        "status": {"type": "string"},
        "active": {"type": "boolean"},
        "root_requirement_id": {"$ref": "#/$defs/identifier"},
        "workflow_instance_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id", "endpoint_role", "status", "root_requirement_id",
        "workflow_instance_id", "workspace_lease_scope", "workspace_lease_state",
        "workspace_lease_owner_issue_id", "workspace_lease_owner_agent_id",
        "workspace_lease_transition_record", "metadata_total_bytes", "metadata_byte_limit", "metadata_scalar_byte_limit"
      ],
      "properties": {
        "issue_id": {"$ref": "#/$defs/identifier"},
        "endpoint_role": {"enum": ["implementation_authority", "final_integration_validation_mirror"]},
        "status": {"type": "string"},
        "root_requirement_id": {"$ref": "#/$defs/identifier"},
        "workflow_instance_id": {"$ref": "#/$defs/identifier"},
        "workspace_lease_scope": {"enum": ["repository", "requirement", "task"]},
        "workspace_lease_state": {"type": "string"},
        "workspace_lease_owner_issue_id": {"type": "string"},
        "workspace_lease_owner_agent_id": {"type": "string"},
        "workspace_lease_transition_record": {"type": ["string", "null"], "pattern": "^v1\\.[A-Za-z0-9_-]+$"},
        "metadata_total_bytes": {"type": "integer", "minimum": 0},
        "metadata_byte_limit": {"type": "integer", "minimum": 1},
        "metadata_scalar_byte_limit": {"type": "integer", "minimum": 1}
      }
    },
    "authority": {"allOf": [{"$ref": "#/$defs/endpoint"}, {"properties": {"endpoint_role": {"const": "implementation_authority"}}}]},
    "mirror": {"allOf": [{"$ref": "#/$defs/endpoint"}, {"properties": {"endpoint_role": {"const": "final_integration_validation_mirror"}}}]}
  }
}
