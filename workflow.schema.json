{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rberyou/multica-dev-workflow/workflow.schema.json",
  "title": "Multica Development Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow", "skills", "agents", "projects", "incidents", "squad"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 3},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "protocol_revision", "approver_role"],
      "properties": {
        "id": {"$ref": "#/$defs/key"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "protocol_revision": {"const": "v4"},
        "approver_role": {"type": "string", "minLength": 1}
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "path", "targets", "attach_to"],
        "properties": {
          "key": {"$ref": "#/$defs/key"},
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "targets": {"type": "array", "uniqueItems": true, "items": {"enum": ["local", "workspace"]}},
          "attach_to": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "description", "runtime_binding", "instruction_files", "max_concurrent_tasks", "permission_mode"],
        "properties": {
          "key": {"$ref": "#/$defs/key"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "runtime_binding": {"$ref": "#/$defs/key"},
          "instruction_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "max_concurrent_tasks": {"type": "integer", "minimum": 1},
          "permission_mode": {"enum": ["private", "public_to_workspace"]},
          "custom_args": {"type": "array", "items": {"type": "string"}},
          "mcp_config": {"type": "object"},
          "runtime_config": {"type": "object"},
          "previous_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "description", "lead", "status"],
        "properties": {
          "key": {"$ref": "#/$defs/key"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "lead": {"$ref": "#/$defs/key"},
          "status": {"type": "string", "minLength": 1},
          "icon": {"type": "string"},
          "previous_titles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "incidents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "skill", "fix_execution_mode", "reporter_agents"],
      "properties": {
        "project": {"$ref": "#/$defs/key"},
        "skill": {"$ref": "#/$defs/key"},
        "fix_execution_mode": {"const": "external"},
        "reporter_agents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}
      }
    },
    "squad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "description", "leader", "instruction_files", "agent_members", "human_members"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "leader": {"$ref": "#/$defs/key"},
        "instruction_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "agent_members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent", "role"],
            "properties": {"agent": {"$ref": "#/$defs/key"}, "role": {"type": "string", "minLength": 1}}
          }
        },
        "human_members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selector", "role"],
            "properties": {"selector": {"enum": ["current_user", "existing_unique_role"]}, "role": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  },
  "$defs": {"key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}
}
