{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rberyou/multica-dev-workflow/workflow.schema.json",
  "title": "Multica Development Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow", "skills", "agents", "projects", "autopilots", "operations", "secure_runtime", "squad"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 2},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "protocol_revision", "approver_role"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "protocol_revision": {"type": "string", "minLength": 1},
        "approver_role": {"type": "string", "minLength": 1}
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "path", "targets", "attach_to"],
        "properties": {
          "key": {"$ref": "#/$defs/key"},
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "targets": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["local", "workspace"]}
          },
          "attach_to": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/key"}
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "description", "runtime_binding", "instruction_files", "max_concurrent_tasks", "permission_mode"],
        "properties": {
          "key": {"$ref": "#/$defs/key"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "runtime_binding": {"$ref": "#/$defs/key"},
          "instruction_files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "max_concurrent_tasks": {"type": "integer", "minimum": 1},
          "permission_mode": {"enum": ["private", "public_to_workspace"]},
          "custom_args": {
            "type": "array",
            "items": {"type": "string"}
          },
          "mcp_config": {
            "type": "object"
          },
          "runtime_config": {
            "type": "object"
          },
          "previous_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "description", "lead", "status"],
        "properties": {
          "key": {"$ref": "#/$defs/key"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "lead": {"$ref": "#/$defs/key"},
          "status": {"type": "string", "minLength": 1},
          "icon": {"type": "string"},
          "previous_titles": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "autopilots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "description", "agent", "mode", "project", "status", "subscribers", "triggers"],
        "properties": {
          "key": {"$ref": "#/$defs/key"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "agent": {"$ref": "#/$defs/key"},
          "mode": {"enum": ["create_issue", "run_only"]},
          "project": {"$ref": "#/$defs/key"},
          "status": {"enum": ["active", "paused"]},
          "issue_title_template": {"type": "string"},
          "subscribers": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["current_user", "human_approver"]}
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "kind", "label", "enabled"],
              "properties": {
                "key": {"$ref": "#/$defs/key"},
                "kind": {"enum": ["schedule", "webhook"]},
                "label": {"type": "string", "minLength": 1},
                "enabled": {"type": "boolean"},
                "cron": {"type": "string", "minLength": 1},
                "timezone": {"type": "string", "minLength": 1}
              },
              "allOf": [
                {
                  "if": {"properties": {"kind": {"const": "schedule"}}},
                  "then": {"required": ["cron", "timezone"]}
                }
              ]
            }
          },
          "previous_titles": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "observer_agent", "observer_skill", "reporter_agents", "autopilot", "full_scan_autopilot", "maintenance_intake_mode", "automatic_expansion"],
      "properties": {
        "project": {"$ref": "#/$defs/key"},
        "observer_agent": {"$ref": "#/$defs/key"},
        "observer_skill": {"$ref": "#/$defs/key"},
        "reporter_agents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/key"}
        },
        "autopilot": {"$ref": "#/$defs/key"},
        "full_scan_autopilot": {"$ref": "#/$defs/key"},
        "maintenance_intake_mode": {"const": "human_gated"},
        "automatic_expansion": {"const": false}
      }
    },
    "secure_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "phase", "required", "open_code_allowed", "agents"],
      "properties": {
        "schema_version": {"const": 1},
        "phase": {"enum": ["planned", "enforced"]},
        "required": {"type": "boolean"},
        "open_code_allowed": {"type": "boolean"},
        "agents": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": ["workflow_maintainer", "workflow_reviewer"]
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"phase": {"const": "planned"}}},
          "then": {
            "properties": {
              "required": {"const": false},
              "open_code_allowed": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"phase": {"const": "enforced"}}},
          "then": {
            "properties": {
              "required": {"const": true},
              "open_code_allowed": {"const": false}
            }
          }
        }
      ]
    },
    "squad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "description", "leader", "instruction_files", "agent_members", "human_members"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "leader": {"$ref": "#/$defs/key"},
        "instruction_files": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "agent_members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent", "role"],
            "properties": {
              "agent": {"$ref": "#/$defs/key"},
              "role": {"type": "string", "minLength": 1}
            }
          }
        },
        "human_members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selector", "role"],
            "properties": {
              "selector": {"enum": ["current_user", "existing_unique_role"]},
              "role": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
  }
}
